{
  "version": "0.4",
  "title": "Course Demo - Header",
  "type": "header",
  "content": [
    {
      "id": "course_header",
      "elType": "container",
      "settings": {
        "css_classes": "course-header",
        "position": "fixed",
        "z_index": "999",
        "width": {"unit": "%", "size": 100},
        "background_background": "classic",
        "background_color": "rgba(255,255,255,0.95)",
        "backdrop_filter_blur": {"unit": "px", "size": 12},
        "border_bottom_border": "solid",
        "border_bottom_width": {"unit": "px", "size": 1},
        "border_bottom_color": "#e2e8f0",
        "padding": {"unit": "px", "top": "16", "right": "24", "bottom": "16", "left": "24", "isLinked": false},
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 1180},
        "flex_direction": "row",
        "align_items": "center",
        "flex_gap": {"unit": "px", "column": "32", "row": "0"}
      },
      "elements": [
        {
          "id": "brand_mark",
          "elType": "container",
          "settings": {
            "width": {"unit": "px", "size": 40},
            "height": {"unit": "px", "size": 40},
            "background_background": "gradient",
            "background_color": "#2563eb",
            "background_color_b": "#7c3aed",
            "background_gradient_angle": {"unit": "deg", "size": 135},
            "border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true},
            "flex_direction": "row",
            "align_items": "center",
            "justify_content": "center"
          },
          "elements": [
            {
              "id": "brand_icon",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "★",
                "header_size": "p",
                "align": "center",
                "title_color": "#ffffff",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 16},
                "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}
              }
            }
          ]
        },
        {
          "id": "brand_name",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Creator Academy",
            "header_size": "p",
            "title_color": "#0f172a",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 17},
            "typography_font_weight": "800",
            "typography_letter_spacing": {"unit": "em", "size": -0.01},
            "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}
          }
        },
        {
          "id": "nav_links",
          "elType": "container",
          "settings": {
            "flex_direction": "row",
            "flex_gap": {"unit": "px", "column": "28", "row": "0"},
            "align_items": "center",
            "flex_grow": "1",
            "justify_content": "center"
          },
          "elements": [
            {
              "id": "nav_courses",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Courses",
                "header_size": "p",
                "title_color": "#64748b",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_font_weight": "500"
              }
            },
            {
              "id": "nav_coaching",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Coaching",
                "header_size": "p",
                "title_color": "#64748b",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_font_weight": "500"
              }
            },
            {
              "id": "nav_membership",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Membership",
                "header_size": "p",
                "title_color": "#64748b",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_font_weight": "500"
              }
            },
            {
              "id": "nav_community",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Community",
                "header_size": "p",
                "title_color": "#64748b",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_font_weight": "500"
              }
            },
            {
              "id": "nav_testimonials",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Testimonials",
                "header_size": "p",
                "title_color": "#64748b",
                "typography_typography": "custom",
                "typography_font_size": {"unit": "px", "size": 15},
                "typography_font_weight": "500"
              }
            }
          ]
        },
        {
          "id": "cta_button",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Start Learning",
            "align": "left",
            "button_type": "default",
            "link": {"url": "#membership"},
            "background_background": "gradient",
            "background_color": "#2563eb",
            "background_color_b": "#7c3aed",
            "background_gradient_angle": {"unit": "deg", "size": 135},
            "button_text_color": "#ffffff",
            "typography_typography": "custom",
            "typography_font_size": {"unit": "px", "size": 15},
            "typography_font_weight": "600",
            "border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true},
            "button_box_shadow_box_shadow_type": "yes",
            "button_box_shadow_box_shadow": {"horizontal": 0, "vertical": 8, "blur": 20, "spread": 0, "color": "rgba(37,99,235,0.22)"},
            "padding": {"unit": "px", "top": "12", "right": "24", "bottom": "12", "left": "24", "isLinked": false}
          }
        }
      ]
    }
  ]
}
