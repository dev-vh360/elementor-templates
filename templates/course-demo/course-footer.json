{
  "version": "0.4",
  "title": "Course Demo - Footer",
  "type": "footer",
  "content": [
    {
      "id": "cf_footer",
      "elType": "container",
      "settings": {
        "css_classes": "course-footer",
        "background_background": "classic",
        "background_color": "#0f172a",
        "padding": {"unit": "px", "top": "60", "right": "24", "bottom": "32", "left": "24", "isLinked": false},
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 1180},
        "flex_direction": "column"
