      "elements": [
        {
          "id": "cf_top",
          "elType": "container",
          "settings": {
            "container_type": "grid",
            "grid_columns_grid": "2fr 1fr 1fr 1fr 1fr 1fr",
            "gap": {"unit": "px", "column": "32", "row": "40"},
            "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "48", "left": "0", "isLinked": false},
            "_tablet_grid_columns_grid": "repeat(3, 1fr)",
            "_mobile_grid_columns_grid": "repeat(2, 1fr)"
          },
          "elements": [
            {
              "id": "cf_brand_col",
              "elType": "container",
              "settings": {"flex_direction": "column"},
              "elements": [
                {
                  "id": "cf_brand_name",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Creator Academy",
                    "header_size": "p",
                    "title_color": "#ffffff",
                    "typography_typography": "custom",
                    "typography_font_size": {"unit": "px", "size": 17},
                    "typography_font_weight": "800",
                    "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "12", "left": "0", "isLinked": false}
                  }
                },
                {
                  "id": "cf_brand_desc",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>A branded video learning platform for courses, live coaching, and paid community memberships.</p>",
                    "text_color": "rgba(255,255,255,0.55)",
                    "typography_typography": "custom",
                    "typography_font_size": {"unit": "px", "size": 13},
                    "typography_line_height": {"unit": "em", "size": 1.65}
                  }
                }
              ]
            },
            {
              "id": "cf_col_courses",
              "elType": "container",
              "settings": {"flex_direction": "column"},
              "elements": [
