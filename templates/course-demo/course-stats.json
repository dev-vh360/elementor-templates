    {
      "id": "cs_stats_outer",
      "elType": "container",
      "settings": {
        "background_background": "classic",
        "background_color": "#f8fafc",
        "padding": {"unit": "px", "top": "0", "right": "24", "bottom": "80", "left": "24", "isLinked": false},
        "content_width": "boxed",
        "boxed_width": {"unit": "px", "size": 1180}
