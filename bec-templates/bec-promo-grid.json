{
  "version": "0.4",
  "title": "BEC Promo - Two-Column Grid Section",
  "type": "section",
  "content": [
    {
      "id": "bec_grid_outer",
      "elType": "container",
      "settings": {
        "_css_classes": "bec-block",
        "padding": {
          "unit": "px",
          "top": "0",
          "right": "0",
          "bottom": "0",
          "left": "0",
          "isLinked": true
        },
        "flex_direction": "column",
        "width": {
          "unit": "%",
          "size": 100
        }
      },
      "elements": [
        {
          "id": "bec_grid_wrap",
          "elType": "container",
          "settings": {
            "_css_classes": "bec-wrap",
            "flex_direction": "column",
            "width": {
              "unit": "%",
              "size": 100
            },
            "content_width": "boxed",
            "boxed_width": {
              "unit": "px",
              "size": 1100
            }
          },
          "elements": [
            {
              "id": "bec_grid_row",
              "elType": "container",
              "settings": {
                "_css_classes": "bec-grid",
                "container_type": "grid",
                "grid_columns_grid": {
                  "size": 12,
                  "unit": "fr"
                },
                "gap": {
                  "unit": "px",
                  "column": "18",
                  "row": "18"
                },
                "width": {
                  "unit": "%",
                  "size": 100
                },
                "_tablet_grid_columns_grid": {
